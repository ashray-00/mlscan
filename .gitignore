mlscan-report.*
report.html
scan-results/
/out/

# Refreshed typosquat corpus. Snapshot of a live API; goes stale, and a
# committed copy invites people to trust it as authoritative. Rebuild with:
#     mlscan refresh-corpus --limit 1000
mlscan/data/corpus_refreshed.json

