# ─────────────────────────────────────────────────────────────
# PROJECT-SPECIFIC — read these before deleting anything
# ─────────────────────────────────────────────────────────────

# Generated test fixtures. These are BUILT, not committed.
#
# They contain pickle streams that import os.system and builtins.eval.
# The payloads are inert (`echo`), but committing files whose whole purpose
# is to look like malware will get your repository flagged by GitHub secret
# and malware scanning, by corporate proxies, and by any AV a reviewer runs.
# `tests/make_fixtures.py` regenerates all of them deterministically in
# under a second, so there is no reason to ship the artifacts.
#
#     python -m tests.make_fixtures
#
tests/fixtures/

# Any model weights a user drops in to scan. Never commit these:
# they are large, usually licensed, and sometimes the very thing you are
# investigating.
models/
checkpoints/
